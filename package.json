{
  "name": "mine-labs",
  "version": "0.1.0",
  "description": "Language-neutral scenario harness for clients tested against a real Minecraft server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aibengineering/mine-labs.git"
  },
  "homepage": "https://github.com/aibengineering/mine-labs#readme",
  "bugs": {
    "url": "https://github.com/aibengineering/mine-labs/issues"
  },
  "bin": {
    "mine-labs": "./bin/mine-labs.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.integration.ts",
    "!src/**/test-fixtures/**",
    "bin",
    "client-mod/src",
    "client-mod/gradle",
    "client-mod/*.gradle",
    "client-mod/gradle.properties",
    "client-mod/README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./src/session/shutdown.integration.ts"
  },
  "keywords": [
    "minecraft",
    "client",
    "harness",
    "testing",
    "scenario",
    "runner",
    "e2e"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "rcon-srcds": "^2.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "typescript": "6.0.3"
  }
}
